# Copy to .env and adjust. Never put a registration token in this file.

# Image to run. Leave unset to build locally (tag: github-runner:local),
# or set to a Docker Hub image, e.g. rahulmohan126/github-runner:latest
#RUNNER_IMAGE=

# Unique per runner. When running several runners, use a separate compose
# project per runner (docker compose -p runner2 ...) with a distinct
# RUNNER_NAME and RUNNER_ROOT (see "Multiple runners" in README.md).
RUNNER_NAME=home-server-runner
# Add a project-specific label (e.g. the repo or org name) to target this
# runner from runs-on.
RUNNER_LABELS=docker,self-hosted,linux

# Runner directory (binaries, registration, job work directory). Bind-mounted
# at the SAME absolute path inside the container, so bind mounts that jobs
# pass to the host Docker daemon resolve. Must be owned by 1001:1001 on the
# host; setup.sh takes care of that.
RUNNER_ROOT=/srv/github-runner

# Optional: register as an ephemeral runner (one job, then deregister).
# Requires ACCESS_TOKEN so the container can re-register itself on restart.
#RUNNER_EPHEMERAL=true

# Optional: Personal access token used to fetch registration tokens
# automatically (enables zero-touch registration and ephemeral mode).
#   Repo runner: fine-grained PAT with "Administration: Read and write"
#   Org runner:  fine-grained PAT with "Self-hosted runners: Read and write"
# Storing a PAT on disk is a trade-off; prefer the one-time setup.sh flow.
#RUNNER_URL=https://github.com/<owner>/<repo>
#ACCESS_TOKEN=

# Default for this deployment: workflows use the HOST Docker daemon, and the
# runner shares the host network so service containers are on localhost.
# WARNING: root-equivalent access to the host. Private, trusted repos only.
# Comment both lines out for a runner without Docker access.
COMPOSE_FILE=docker-compose.yml:docker-compose.docker-socket.yml
# The socket's group ID inside a container (usually 0 on Docker Desktop, the
# docker group's GID on Linux):
#   docker run --rm -v /var/run/docker.sock:/var/run/docker.sock busybox stat -c %g /var/run/docker.sock
DOCKER_GID=
